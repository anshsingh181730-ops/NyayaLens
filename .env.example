# ==============================================================================
# NyayaLens Environment Configuration
# ==============================================================================

# Anthropic API Key (Required for LLM summarization, verification, and law agent)
ANTHROPIC_API_KEY=your_anthropic_api_key_here

# LLM Models
LLM_MODEL=claude-3-5-sonnet-20241022
LLM_FAST_MODEL=claude-3-5-haiku-20241022

# Multilingual Embedding Model for ChromaDB Semantic Vector Retrieval
EMBEDDING_MODEL_NAME=paraphrase-multilingual-MiniLM-L12-v2

# Storage & Database
DATABASE_URL=sqlite:///nyayalens.db

# Authentication & Security
JWT_SECRET=your_jwt_secret_key_change_in_production

# OCR Configuration (Optional path override for Tesseract executable if not in PATH)
# OCR_TESSERACT_CMD=C:\Program Files\Tesseract-OCR\tesseract.exe
